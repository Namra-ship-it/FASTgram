{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build FASTgram (Debug)",
            "type": "shell",
            "command": "& 'C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe' '${workspaceFolder}\\fastgram.sln' /p:Configuration=Debug /p:Platform=x64",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run FASTgram",
            "type": "shell",
            "command": "Set-Location '${workspaceFolder}'; & '.\\bin\\Debug\\fastgram.exe'",
            "dependsOn": "Build FASTgram (Debug)",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
